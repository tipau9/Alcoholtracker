<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app is dark-only, like the iOS one. Compose paints everything, so this
      only has to keep the window and status bar from flashing light.
    -->
    <style name="Theme.Promille" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0807</item>
        <item name="android:statusBarColor">#0A0807</item>
        <item name="android:navigationBarColor">#0A0807</item>
    </style>
</resources>
